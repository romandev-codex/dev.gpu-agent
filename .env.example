# .env — Hermes + llama.cpp configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# =============================================================================
# llama.cpp server
# =============================================================================

# Filename of the GGUF model to load (must be placed in ./models/)
LLAMA_MODEL=model.gguf

# Number of layers to offload to GPU  (99 = all layers; set lower if VRAM is limited)
N_GPU_LAYERS=99

# Context window size in tokens
CTX_SIZE=8192

# Concurrent request slots (parallel inference)
N_PARALLEL=4

# Host port for the llama.cpp server (default 8080)
LLAMA_PORT=8080

# Optional API key to authenticate requests to llama.cpp.
# If set, Hermes will pass it as a Bearer token automatically.
# Leave blank to disable authentication on the llama.cpp endpoint.
LLAMA_API_KEY=

# =============================================================================
# Hermes Agent — LLM providers
# =============================================================================

# OpenRouter — access 200+ cloud models via a single key
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI — direct access (optional, for Whisper TTS / voice features)
OPENAI_API_KEY=

# =============================================================================
# Hermes Agent — messaging integrations (all optional)
# =============================================================================

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Discord
DISCORD_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=

# =============================================================================
# Hermes Agent — tool API keys (all optional)
# =============================================================================

# Exa — AI-native web search
EXA_API_KEY=

# Firecrawl — web scraping / crawl
FIRECRAWL_API_KEY=

# FAL.ai — image generation
FAL_KEY=

# GitHub — higher rate limits for Skills Hub
GITHUB_TOKEN=

# Groq — cloud Whisper for voice transcription
GROQ_API_KEY=
